# --- Preferred: full cookie string (most reliable) ---
# In your browser, log into LinkedIn, open DevTools (F12) -> Network tab,
# click any request to linkedin.com, find "Cookie:" under Request Headers,
# and copy its ENTIRE value (one long string with many cookies in it).
LINKEDIN_COOKIE_STRING=

# --- REQUIRED alongside the cookie: your browser's real User-Agent ---
# LinkedIn ties a session to the browser it was issued to. Search
# "what's my user agent" on Google in the SAME browser you copied the
# cookie from, and paste the result here exactly. Mismatching this is
# what caused session/redirect errors during development of this project.
LINKEDIN_USER_AGENT=

# --- Fallback: just two cookies (less reliable, may cause session issues) ---
LI_AT_COOKIE=
JSESSIONID=

# --- Last resort: password-based auth (likely to hit a checkpoint) ---
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# --- Optional ---
CACHE_TTL_SECONDS=300
